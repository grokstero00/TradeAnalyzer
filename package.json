{
  "name": "tradeanalyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Chart reader & market-analysis app: connects to Bybit/Binance (MT5 later), computes technical indicators, and produces advisory Buy/Sell/Hold signals for iOS & Android.",
  "workspaces": [
    "shared",
    "backend",
    "mobile"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace shared",
    "dev:backend": "npm run dev --workspace backend",
    "test:backend": "npm run test --workspace backend",
    "start:mobile": "npm run start --workspace mobile",
    "test": "npm run test --workspace backend"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
