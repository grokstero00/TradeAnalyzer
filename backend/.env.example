# ---------------------------------------------------------------------------
# TradeAnalyzer backend configuration. Copy to `.env` and fill in.
# NEVER commit the real .env file (it is gitignored).
# ---------------------------------------------------------------------------

# Port the API server listens on.
PORT=4000

# CORS: comma-separated origins allowed to call the API. Use * for local dev.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Master key for encrypting stored exchange API keys (AES-256-GCM).
# Generate a strong one with:  openssl rand -hex 32
# If unset, the server refuses to store any real keys (safe default).
# ---------------------------------------------------------------------------
VAULT_MASTER_KEY=

# Where encrypted key material is stored on disk (gitignored).
VAULT_FILE=./data/vault.json

# ---------------------------------------------------------------------------
# Optional: set to "true" to allow live exchange calls via ccxt.
# When false (default), the backend uses synthetic sample candles so you can
# develop the whole app with zero API keys and zero risk.
# ---------------------------------------------------------------------------
ENABLE_LIVE_EXCHANGE=false
